# Copy to .env for local runs outside Docker. Never commit .env.
DATABASE_URL=postgres://orbyn@localhost:5432/orbyn
ORBYN_BIND=127.0.0.1:8080
ORBYN_ALLOWED_ORIGINS=http://localhost:5173
ORBYN_LOG=info
# The sign-in secret: `cargo run -p orbyn-cli -- auth-setup`. Without it sign-in answers 503.
ORBYN_AUTH_SETUP=
# Set only behind a trusted proxy that writes the client address, such as x-forwarded-for.
ORBYN_CLIENT_IP_HEADER=
